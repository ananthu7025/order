# Neon Postgres connection string.
# Get this from your Neon project dashboard (Connection Details).
# The @neondatabase/serverless HTTP driver works fine with the pooled connection string.

DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Telegram bot token from @BotFather. Used by the long-polling bot script
# (scripts/telegram-bot.ts) to receive buyer messages and by the API routes
# it calls to reach the Telegram Bot API.
TELEGRAM_BOT_TOKEN="<bot-token-from-botfather>"

# Base URL the bot script uses to call this app's own API routes
# (POST /api/leads/inbound). Defaults to localhost for local dev.
APP_URL="http://localhost:3000"

# Groq API key (https://console.groq.com/keys). Used by lib/telegram/extract.ts
# to pull structured requirement details out of the buyer's free-text
# messages. Optional — if unset, the Telegram bot falls back to asking one
# field at a time instead of failing.
GROQ_API_KEY="gsk_..."
